# Ключ авторизации из проекта GigaChat API Studio.
GIGACHAT_CREDENTIALS=

# Для физлица:
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Для ИП/юрлица выберите соответствующий scope:
# GIGACHAT_API_B2B
# GIGACHAT_API_CORP

GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_TIMEOUT=180

# Для локальной среды, если нет сертификата НУЦ Минцифры.
# В рабочей среде лучше установить сертификат и поставить true.
GIGACHAT_VERIFY_SSL_CERTS=false

TENDER_INPUT=
TENDER_OUTPUT=

# AI-контекст и адаптивный чанкинг
TENDER_AI_MAX_PROMPT_CHARS=60000
TENDER_AI_KB_CHUNK_CHARS=26000
TENDER_AI_429_RETRIES=3
TENDER_AI_429_BASE_DELAY=2
AI_CONFIDENCE_THRESHOLD=0.75
